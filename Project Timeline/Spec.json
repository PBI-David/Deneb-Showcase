      "format": {"parse": {"start": "utc:'%d/%m/%Y'", "end": "utc:'%d/%m/%Y'"}}
    },
    {
      "name": "input",
      "source": "dataset",
      "transform": [
        {
          "type": "formula",
          "as": "start",
          "expr": "datetime(utc(year(datum.start),month(datum.start),date(datum.start),hours(datum.start),minutes(datum.start)))"
        },
        {
          "type": "formula",
          "as": "end",
          "expr": "datetime(utc(year(datum.end),month(datum.end),date(datum.end),hours(datum.end),minutes(datum.end)))"
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["index"],
          "sort": {"field": "start", "order": "ascending"}
        },
        {
          "type": "formula",
          "as": "days",
          "expr": "round(((datum.end-datum.start)/oneDay)*10)/10"
        },
        {"type": "filter", "expr": "datum.days > 1"}
      ]
    }
  ],
  "signals": [
    {
      "name": "colours",
      "value": {
        "dark": ["#377eb9", "#4db04a", "#974ea2", "#ff8000"],
        "light": ["#a5c8e4", "#b5dfb3", "#d3b0d9", "#ffcc99"],
        "font": ["#2a67ce", "#137333", "#63336a", "#b25900"]
      }
    },
    {"name": "oneDay", "init": "1000*60*60*24"},
    {"name": "circleArea", "init": "300"},
    {"name": "circleRadius", "init": "sqrt(circleArea/PI)"},
    {"name": "horizontalPadding", "init": "10"}
  ],
  "scales": [
    {
      "name": "yscale",
      "type": "band",
      "domain": {
        "data": "input",
        "field": "index",
        "sort": {"field": "index", "op": "max", "order": "ascending"}
      },
      "range": {"step": 80},
      "padding": 0
    },
    {
      "name": "cDark",
      "type": "ordinal",
      "range": {"signal": "colours.dark"},
      "domain": {"data": "input", "field": "phase"}
    },
    {
      "name": "cFont",
      "type": "ordinal",
      "range": {"signal": "colours.font"},
      "domain": {"data": "input", "field": "phase"}
    },
    {
      "name": "cLight",
      "type": "ordinal",
      "range": {"signal": "colours.light"},
      "domain": {"data": "input", "field": "phase"}
    }
  ],
  "marks": [
    {
      "name": "dates",
      "from": {"data": "input"},
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 0},
          "y": {"scale": "yscale", "field": "index", "band": 0},
          "text": {"signal": "utcFormat(datum.start,'%d %b %Y')"},
          "baseline": {"value": "middle"},
          "align": {"value": "left"},
          "fontWeight": {"value": "bold"},
          "fontSize": {"value": 12},
          "fill": {"value": "#52719d"}
        }
      }
    },
    {
      "name": "circles",
      "from": {"data": "dates"},
      "type": "symbol",
      "encode": {
        "enter": {
          "y": {"scale": "yscale", "field": "datum.index", "band": 0},
          "size": {"signal": "circleArea"},
          "x": {
            "signal": " datum.bounds.x2 + circleRadius + horizontalPadding"
          },
          "fill": {"scale": "cDark", "field": "datum.phase"},
          "stroke": {"scale": "cLight", "field": "datum.phase"},
          "strokeWidth": {"value": 3}
        }
      }
    },
    {
      "name": "lines",
      "from": {"data": "dates"},
      "type": "rule",
      "encode": {
        "enter": {
          "y": {"scale": "yscale", "field": "datum.index", "band": 0.2},
          "y2": {"scale": "yscale", "field": "datum.index", "band": 0.8},
          "x": {"signal": " datum.bounds.x2 + circleRadius+horizontalPadding"},
          "strokeWidth": {"value": 3},
          "stroke": {"value": "#777"}
        }
      }
    },
    {
      "name": "headings",
      "from": {"data": "dates"},
      "type": "text",
      "encode": {
        "enter": {
          "y": {"scale": "yscale", "field": "datum.index", "band": 0},
          "x": {
            "signal": " datum.bounds.x2 + (circleRadius*2)+horizontalPadding*2"
          },
          "text": {"signal": "datum.datum.phase"},
          "align": {"value": "left"},
          "baseline": {"value": "middle"},
          "fontWeight": {"value": "bold"},
          "fontSize": {"value": 13},
          "fill": {"value": "#274e82"}
        }
      }
    },
    {
      "name": "tasks",
      "from": {"data": "headings"},
      "type": "text",
      "encode": {
        "enter": {
          "y": {"field": "bounds.y2", "offset": 15},
          "x": {"field": "bounds.x1"},
          "fill": {"value": "#777"},
          "text": {"signal": "datum.datum.datum.task"},
          "fontSize": {"value": 12}
        },
        "update": {
          "limit": {
            "signal": "width-(datum.datum.bounds.x2-datum.datum.bounds.x1)-(circleRadius*2)-(horizontalPadding*2)"
          }
        }
      }
    },
    {
      "name": "dayLabel",
      "from": {"data": "tasks"},
      "type": "text",
      "zindex": 1,
      "encode": {
        "enter": {
          "y": {"field": "bounds.y2", "offset": 21},
          "x": {"field": "bounds.x1", "offset": 4},
          "fill": {"scale": "cFont", "field": "datum.datum.datum.phase"},
          "text": {
            "signal": "datum.datum.datum.datum.days + (datum.datum.datum.datum.days>1? ' days':' day')"
          },
          "fontSize": {"value": 12}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "dayLabel"},
      "encode": {
        "update": {
          "x": {"field": "bounds.x1", "offset": -6},
          "x2": {"field": "bounds.x2", "offset": 6},
          "y": {"field": "bounds.y1", "offset": -4},
          "y2": {"field": "bounds.y2", "offset": 3},
          "fillOpacity": {"value": 0.3},
          "fill": {"scale": "cLight", "field": "datum.datum.datum.datum.phase"},
          "cornerRadius": {"value": 8}
        }
      }
    }
  ]
}